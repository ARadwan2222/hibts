<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <TextView
        android:id="@+id/tvHelpHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="hibts Guide"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/helpProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        app:trackThickness="4dp"
        app:trackCornerRadius="2dp"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/tvHelpHeader" />

    <ViewFlipper
        android:id="@+id/helpFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/layoutHelpNav"
        app:layout_constraintTop_toBottomOf="@id/helpProgress">

        <!-- Page 1 -->
        <include layout="@layout/item_help_page" android:id="@+id/page1" />
        <!-- Page 2 -->
        <include layout="@layout/item_help_page" android:id="@+id/page2" />
        <!-- Page 3 -->
        <include layout="@layout/item_help_page" android:id="@+id/page3" />
        <!-- Page 4 -->
        <include layout="@layout/item_help_page" android:id="@+id/page4" />
        <!-- Page 5 -->
        <include layout="@layout/item_help_page" android:id="@+id/page5" />
        <!-- Page 6 -->
        <include layout="@layout/item_help_page" android:id="@+id/page6" />

    </ViewFlipper>

    <LinearLayout
        android:id="@+id/layoutHelpNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnPrevHelp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/previous"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btnNextHelp"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/next"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>